datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS (Strict Compile-time & Database Typing)
// -----------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  SALON_OWNER
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SalonStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEACTIVATED
}

enum StylistStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SalonUserStatus {
  ACTIVE
  BLOCKED
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  PENDING_RESCHEDULE
}

enum BookingSource {
  WHATSAPP
  WEB
  CUSTOMER_APP
  PHONE
  WALK_IN
  MANUAL
}

enum DayOfWeek {
  SUNDAY    // 0
  MONDAY    // 1
  TUESDAY   // 2
  WEDNESDAY // 3
  THURSDAY  // 4
  FRIDAY    // 5
  SATURDAY  // 6
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  PROCESSED
  SENT
  FAILED
  IGNORED
}

enum ConversationState {
  START
  ACTIVE_HUB
  SELECT_ADDON
  ADDON_CONFLICT
  SELECT_RESCHEDULE_DATE
  SELECT_RESCHEDULE_TIME
  CONFIRM_CANCEL
  SELECT_APPOINTMENT
  SELECT_CATEGORY
  SELECT_SERVICE
  SELECT_STAFF
  SELECT_DATE
  SELECT_TIME
  COLLECT_NAME
  CONFIRMATION
  COMPLETED
}

enum ServiceGender {
  MALE
  FEMALE
  UNISEX
  KIDS
}

enum ClientEtaStatus {
  ON_THE_WAY
  ON_TIME
  RUNNING_LATE_10M
  RUNNING_LATE_20M
  CANCEL_REQUESTED
  ARRIVED
}

// -----------------------------------------------------------------------------
// 1. ADMINS (Super Admin & Salon Owners)
// -----------------------------------------------------------------------------
model Admin {
  id           String      @id @default(uuid())
  salonId      String?     @map("salon_id") // NULL for SUPER_ADMIN; required for SALON_OWNER
  name         String
  email        String      @unique
  phone        String?
  passwordHash String      @map("password_hash")
  role         AdminRole   @default(SALON_OWNER)
  status       AdminStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  salon               Salon?        @relation("SalonAdmin", fields: [salonId], references: [id], onDelete: SetNull)
  createdSalons       Salon[]       @relation("AdminCreatedSalons")
  createdAppointments Appointment[] @relation("AdminCreatedAppointments")
  auditLogs           AuditLog[]
  sessions            UserSession[]

  @@index([email])
  @@index([salonId])
  @@map("admins")
}

// -----------------------------------------------------------------------------
// 1B. USER SESSIONS (Production Session Security, RTR & Device Tracking)
// -----------------------------------------------------------------------------
model UserSession {
  id           String    @id @default(uuid())
  adminId      String    @map("admin_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  expiresAt    DateTime  @map("expires_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
  @@map("user_sessions")
}

// -----------------------------------------------------------------------------
// 2. SALONS
// -----------------------------------------------------------------------------
model Salon {
  id                   String      @id @default(uuid())
  createdByAdminId     String      @map("created_by_admin_id")
  name                 String
  slug                 String      @unique
  logoUrl              String?     @map("logo_url")
  phone                String
  email                String
  address              String?
  city                 String?
  state                String?
  country              String      @default("IN")
  timezone             String      @default("Asia/Kolkata")
  description          String?
  status               SalonStatus @default(ACTIVE)

  // Default operating hours used for 7-day initial seeding
  defaultStartTime     String      @default("09:00") @map("default_start_time")
  defaultEndTime       String      @default("21:00") @map("default_end_time")

  // Booking settings
  maxAdvanceDays       Int         @default(30) @map("max_advance_days")
  cancelWindowHours    Int         @default(2) @map("cancel_window_hours")
  allowSpecificStylist Boolean     @default(true) @map("allow_specific_stylist")

  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  createdByAdmin       Admin       @relation("AdminCreatedSalons", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  admins               Admin[]     @relation("SalonAdmin")
  stylists             Stylist[]
  serviceCategories    ServiceCategory[]
  services             Service[]
  workingHours         SalonWorkingHours[]
  salonUsers           SalonUser[]
  appointments         Appointment[]
  conversations        Conversation[]
  whatsappAccount      WhatsAppAccount?
  whatsappLogs         WhatsAppLog[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@index([createdByAdminId])
  @@index([slug])
  @@index([status])
  @@map("salons")
}

// -----------------------------------------------------------------------------
// 3. SERVICES (Prerequisite before Stylists)
// -----------------------------------------------------------------------------
model ServiceCategory {
  id        String    @id @default(uuid())
  salonId   String    @map("salon_id")
  name      String
  icon      String?   @default("scissors")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services  Service[]

  @@unique([salonId, name])
  @@unique([salonId, id])
  @@index([salonId, sortOrder])
  @@map("service_categories")
}

model Service {
  id              String           @id @default(uuid())
  salonId         String           @map("salon_id")
  categoryId      String?          @map("category_id")
  name            String
  description     String?
  category        String?
  targetGender    ServiceGender    @default(UNISEX) @map("target_gender")
  price           Decimal          @db.Decimal(10, 2)
  durationMinutes Int              @map("duration_minutes")
  status          ServiceStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  salon           Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stylists        StylistService[]
  appointments    Appointment[]
  appointmentServices AppointmentService[]

  @@unique([salonId, id])
  @@index([salonId, status])
  @@index([salonId, name])
  @@map("services")
}

// -----------------------------------------------------------------------------
// 4. STYLISTS & STYLIST SERVICES
// -----------------------------------------------------------------------------
model Stylist {
  id                   String        @id @default(uuid())
  salonId              String        @map("salon_id")
  name                 String
  phone                String?
  email                String?
  profileImageUrl      String?       @map("profile_image_url")
  status               StylistStatus @default(ACTIVE)
  
  // Follows salon schedule or custom stylist hours
  followsSalonSchedule Boolean       @default(true) @map("follows_salon_schedule")

  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  salon                Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services             StylistService[]
  workingHours         StylistWorkingHours[]
  appointments         Appointment[]

  @@unique([salonId, id])
  @@index([salonId, status])
  @@index([salonId, name])
  @@map("stylists")
}

model StylistService {
  salonId   String   @map("salon_id")
  stylistId String   @map("stylist_id")
  serviceId String   @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  stylist   Stylist  @relation(fields: [salonId, stylistId], references: [salonId, id], onDelete: Cascade)
  service   Service  @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Cascade)

  @@id([salonId, stylistId, serviceId])
  @@index([salonId, serviceId])
  @@map("stylist_services")
}

// -----------------------------------------------------------------------------
// 5. WORKING HOURS & BREAKS
// -----------------------------------------------------------------------------
model SalonWorkingHours {
  id             String    @id @default(uuid())
  salonId        String    @map("salon_id")
  dayOfWeek      DayOfWeek @map("day_of_week")
  isClosed       Boolean   @default(false) @map("is_closed")
  startTime      String    @map("start_time")       // "09:00"
  endTime        String    @map("end_time")         // "21:00"
  breakStartTime String?   @map("break_start_time") // "13:00"
  breakEndTime   String?   @map("break_end_time")   // "14:00"
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  salon          Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, dayOfWeek])
  @@map("salon_working_hours")
}

model StylistWorkingHours {
  id             String    @id @default(uuid())
  stylistId      String    @map("stylist_id")
  dayOfWeek      DayOfWeek @map("day_of_week")
  isWorking      Boolean   @default(true) @map("is_working")
  startTime      String    @map("start_time")       // "10:00"
  endTime        String    @map("end_time")         // "18:00"
  breakStartTime String?   @map("break_start_time") // "13:00"
  breakEndTime   String?   @map("break_end_time")   // "14:00"
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stylist        Stylist   @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
  @@map("stylist_working_hours")
}

// -----------------------------------------------------------------------------
// 6. CUSTOMERS / USERS & SALON USERS
// -----------------------------------------------------------------------------
model User {
  id        String     @id @default(uuid())
  name      String?
  phone     String     @unique
  email     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  salonMemberships SalonUser[]
  notifications    Notification[]

  @@index([phone])
  @@map("users")
}

model SalonUser {
  id                 String          @id @default(uuid())
  salonId            String          @map("salon_id")
  userId             String          @map("user_id")
  status             SalonUserStatus @default(ACTIVE)
  notes              String?

  yearlyNoShowCount  Int             @default(0) @map("yearly_no_show_count")
  lastNoShowDate     DateTime?       @map("last_no_show_date")
  isBookingBlocked   Boolean         @default(false) @map("is_booking_blocked")
  gender             ServiceGender?  @default(UNISEX)

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  salon        Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([salonId, id])
  @@unique([salonId, userId])
  @@index([salonId])
  @@index([userId])
  @@map("salon_users")
}

// -----------------------------------------------------------------------------
// 7. APPOINTMENTS (The Source of Truth)
// -----------------------------------------------------------------------------
model Appointment {
  id                  String            @id @default(uuid())
  appointmentNumber   String            @unique @map("appointment_number")
  salonId             String            @map("salon_id")
  salonUserId         String            @map("salon_user_id")
  stylistId           String            @map("stylist_id")
  serviceId           String?           @map("service_id")

  // Snapshots for immutability
  serviceNameSnapshot String            @map("service_name_snapshot")
  durationMinutes     Int               @map("duration_minutes")
  price               Decimal           @db.Decimal(10, 2)

  // Booking boundaries
  startAt             DateTime          @map("start_at") @db.Timestamptz
  endAt               DateTime          @map("end_at") @db.Timestamptz
  appointmentDate     DateTime          @map("appointment_date") @db.Date

  // Status & Tracking
  status              AppointmentStatus @default(CONFIRMED)
  source              BookingSource     @default(WHATSAPP)
  expiresAt           DateTime?         @map("expires_at") @db.Timestamptz
  notes               String?
  createdByAdminId    String?           @map("created_by_admin_id")

  proposedStartAt     DateTime?         @map("proposed_start_at") @db.Timestamptz
  proposedEndAt       DateTime?         @map("proposed_end_at") @db.Timestamptz
  proposedByAdminId   String?           @map("proposed_by_admin_id")

  reminder2hSentAt    DateTime?         @map("reminder_2h_sent_at") @db.Timestamptz
  reminder10mSentAt   DateTime?         @map("reminder_10m_sent_at") @db.Timestamptz
  lateFollowUpSentAt  DateTime?         @map("late_follow_up_sent_at") @db.Timestamptz
  clientEtaStatus     ClientEtaStatus?  @map("client_eta_status")

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  salon               Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  salonUser           SalonUser         @relation(fields: [salonId, salonUserId], references: [salonId, id], onDelete: Restrict)
  stylist             Stylist           @relation(fields: [salonId, stylistId], references: [salonId, id], onDelete: Restrict)
  service             Service?          @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: SetNull)
  services            AppointmentService[]
  createdByAdmin      Admin?            @relation("AdminCreatedAppointments", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  notifications       Notification[]

  @@unique([salonId, id])
  @@index([salonId, appointmentDate])
  @@index([salonId, stylistId, appointmentDate])
  @@index([stylistId, startAt, endAt])
  @@index([salonId, salonUserId, appointmentDate])
  @@index([salonId, status])
  @@map("appointments")
}

model AppointmentService {
  id                  String      @id @default(uuid())
  salonId             String      @map("salon_id")
  appointmentId       String      @map("appointment_id")
  serviceId           String?     @map("service_id")
  serviceNameSnapshot String      @map("service_name_snapshot")
  durationMinutes     Int         @map("duration_minutes")
  price               Decimal     @db.Decimal(10, 2)
  orderIndex          Int         @default(0) @map("order_index")
  createdAt           DateTime    @default(now()) @map("created_at")

  appointment         Appointment @relation(fields: [salonId, appointmentId], references: [salonId, id], onDelete: Cascade)
  service             Service?    @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: SetNull)

  @@index([salonId, appointmentId])
  @@index([salonId, serviceId])
  @@map("appointment_services")
}

// -----------------------------------------------------------------------------
// 8. WHATSAPP & CONVERSATIONS
// -----------------------------------------------------------------------------
model Conversation {
  id                  String            @id @default(uuid())
  salonId             String            @map("salon_id")
  customerPhone       String            @map("customer_phone")
  state               ConversationState @default(START)
  selectedServiceId   String?           @map("selected_service_id")
  selectedCategoryId  String?           @map("selected_category_id")
  tempBookingGender   ServiceGender?    @map("temp_booking_gender")
  selectedStaffId     String?           @map("selected_staff_id")
  selectedDate        DateTime?         @map("selected_date") @db.Date
  selectedStartTime   DateTime?         @map("selected_start_time") @db.Timestamptz
  customerName        String?           @map("customer_name")
  activeAppointmentId   String?           @map("active_appointment_id")
  pendingAddonServiceId String?           @map("pending_addon_service_id")

  isBotPaused         Boolean           @default(false) @map("is_bot_paused")
  botPausedUntil      DateTime?         @map("bot_paused_until") @db.Timestamptz

  updatedAt             DateTime          @updatedAt @map("updated_at")

  salon               Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, customerPhone])
  @@index([customerPhone])
  @@map("conversations")
}

model WhatsAppAccount {
  id                   String   @id @default(uuid())
  salonId              String   @unique @map("salon_id")
  phoneNumberId        String   @unique @map("phone_number_id")
  wabaId               String?  @map("waba_id")
  accessTokenEncrypted String   @map("access_token_encrypted")
  webhookVerifyToken   String   @map("webhook_verify_token")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  salon                Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

model WhatsAppLog {
  id                String                   @id @default(uuid())
  salonId           String?                  @map("salon_id")
  phone             String
  direction         WhatsAppMessageDirection @default(INBOUND)
  messageText       String?                  @map("message_text")
  interactiveId     String?                  @map("interactive_id")
  conversationState String?                  @map("conversation_state")
  status            WhatsAppMessageStatus    @default(RECEIVED)
  metaMessageId     String?                  @unique @map("meta_message_id")
  errorCode         Int?                     @map("error_code")
  errorMessage      String?                  @map("error_message")
  rawPayload        Json?                    @map("raw_payload")
  createdAt         DateTime                 @default(now()) @map("created_at")

  salon             Salon?                   @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([salonId, createdAt])
  @@index([salonId, status])
  @@map("whatsapp_logs")
}

model Notification {
  id                String              @id @default(uuid())
  salonId           String              @map("salon_id")
  appointmentId     String?             @map("appointment_id")
  userId            String?             @map("user_id")
  recipientPhone    String              @map("recipient_phone")
  channel           NotificationChannel @default(WHATSAPP)
  templateName      String?             @map("template_name")
  messageBody       String              @map("message_body")
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  errorDetails      String?             @map("error_details")
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  salon             Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment       Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([salonId, status])
  @@index([appointmentId])
  @@index([userId])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// 9. AUDIT LOGGING
// -----------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  salonId    String?  @map("salon_id")
  adminId    String?  @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  salon      Salon?   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt])
  @@index([entityType, entityId])
  @@index([adminId])
  @@map("audit_logs")
}
