# Production Environment Configuration Template for Render / Railway / AWS
PORT=10000
NODE_ENV=production
APP_ENV=production
IS_PRODUCTION_DB=true

# Remote PostgreSQL Production Database Connection String (e.g., Render / Supabase / Neon)
DATABASE_URL="postgresql://user:password@production-db-host.com:5432/salon_saas_prod?sslmode=require"

# Production JWT Secret (Minimum 32 random secure characters)
JWT_SECRET="production-super-secret-jwt-key-min-32-chars-length"
JWT_EXPIRES_IN="7d"

# Production Frontend & Webhook CORS Allowed Origins
CORS_ORIGINS="https://your-salon-frontend.vercel.app,https://salon-api-tuwo.onrender.com"

# Meta WhatsApp Cloud API Production Credentials
WHATSAPP_PHONE_NUMBER_ID="your_production_meta_phone_number_id"
WHATSAPP_ACCESS_TOKEN="EAAG..." # Permanent System User Token from Meta Business Manager
WHATSAPP_VERIFY_TOKEN="your_custom_production_webhook_verify_token"
